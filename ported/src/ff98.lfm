    object popFolDocNew: TMenuItem
      Caption = 'New &Document ...'
      OnClick = docNewClick
    end
  end
  object GMTimer: TTimer
    Enabled = False
    OnTimer = GMTimerTimer
    Left = 332
    Top = 352
  end
end
